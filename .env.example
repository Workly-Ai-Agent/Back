# Spring profile: default for local H2, prod for PostgreSQL deployment
SPRING_PROFILES_ACTIVE=default

# JWT configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=https://workly-flax-delta.vercel.app,http://localhost:5173

# Required when SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-database-password

# 배포 시 아래 값으로 변경합니다.
# SPRING_PROFILES_ACTIVE=prod
# JWT_COOKIE_SECURE=true
